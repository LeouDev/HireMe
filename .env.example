# ---- Browser (public, bundled into the frontend; safe to expose) ----
VITE_SUPABASE_URL=https://ljzbigcsrosbqwsvgdrh.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Absolute site URL used for canonical links and share links.
VITE_PUBLIC_APP_URL=http://localhost:5173

# ---- Server only (Vercel Functions). Never prefix these with VITE_. ----
SUPABASE_URL=https://ljzbigcsrosbqwsvgdrh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PUBLIC_APP_URL=http://localhost:5173

# PayMongo (https://dashboard.paymongo.com/developers). Use sk_test_ keys in development.
PAYMONGO_SECRET_KEY=sk_test_xxx
# Webhook signing secret (whsk_...) returned when the webhook endpoint is created.
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Live keys are refused until this is "true", i.e. until PayMongo has approved the merchant/settlement model.
PAYMONGO_LIVE_APPROVED=false
# Comma-separated PayMongo payment method types enabled on the merchant account.
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph

# Shared secret for the scheduled housekeeping endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=generate-a-long-random-string
